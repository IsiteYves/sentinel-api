# ── Supabase ────────────────────────────────────────────────────────────────
# Project URL from: Supabase dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co

# Service-role secret key (NOT the anon key — this key bypasses RLS)
# Supabase dashboard → Settings → API → service_role
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Hive AI — deepfake detection (optional) ──────────────────────────────────
# Sign up at https://thehive.ai → Dashboard → API Keys
# If omitted, deepfake analysis is skipped and labelled "not configured"
HIVE_API_KEY=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,https://sentinel-saver.vercel.app
